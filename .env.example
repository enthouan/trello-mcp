######################
# Environment        #
######################

### Required Trello Credentials
TRELLO_API_KEY=replace-me
TRELLO_TOKEN=replace-me

### Common
TIMEZONE=UTC

### Runtime
TRANSPORT=http
LOG_LEVEL=info

### Docker Compose
# Use 127.0.0.1 for local-only access, or 0.0.0.0 to expose on all host interfaces.
TRELLO_MCP_HOST_BIND_IP=127.0.0.1
TRELLO_MCP_HOST_PORT=3000
TRELLO_MCP_IMAGE_TAG=latest
TRELLO_MCP_NETWORK=trello_mcp

# Note: future webhook tools require callback URLs that are publicly reachable by Trello.
