# Required Trello credentials. Generate these in Trello's developer portal.
TRELLO_API_KEY=replace-me
TRELLO_TOKEN=replace-me

# Transport mode: http for containers and MCP HTTP/SSE clients, stdio for local process clients.
TRANSPORT=http
PORT=3000
LOG_LEVEL=info

# Note: future webhook tools require callback URLs that are publicly reachable by Trello.
