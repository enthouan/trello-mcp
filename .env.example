######################
# Environment        #
######################

### Required Trello Credentials
TRELLO_API_KEY=replace-me
TRELLO_TOKEN=replace-me

### Runtime
TRANSPORT=http
LOG_LEVEL=info

### Trello Rate Limit And Retry Tuning
# Defaults preserve the built-in limiter: 100 requests per 10 seconds.
# Lower these for shared tokens or raise them carefully for large workflows.
TRELLO_RATE_LIMIT_CAPACITY=100
TRELLO_RATE_LIMIT_REFILL_INTERVAL_MS=10000
TRELLO_RETRY_MAX_ATTEMPTS=3
TRELLO_RETRY_BASE_DELAY_MS=100
TRELLO_RETRY_MAX_DELAY_MS=2000

### Optional HTTP MCP Auth
# If set, HTTP requests to /mcp require Authorization: Bearer <token>.
# Leave unset to disable the HTTP bearer-token check.
# MCP_AUTH_TOKEN=replace-me

### Optional Attachment Uploads
# Enables card_attachment_upload for files inside this server-side directory.
# Leave unset to disable local file uploads.
# TRELLO_ATTACHMENT_UPLOAD_ROOT=/absolute/path/to/trello-uploads

### Optional Live Smoke Tests
# These are only read by `corepack pnpm smoke:live`; normal tests and runtime
# startup do not use them. Point this at a board reserved for disposable
# validation artifacts.
# TRELLO_LIVE_SMOKE=1
# TRELLO_LIVE_SMOKE_BOARD_ID=replace-with-disposable-board-id-or-short-link
# TRELLO_LIVE_SMOKE_BOARD_URL=https://trello.com/b/shortlink/disposable-board
# TRELLO_LIVE_SMOKE_RUN_ID=optional-human-readable-run-id

### Optional Live Regression Tests
# These are only read by `corepack pnpm regression:live`; normal tests,
# runtime startup, and `corepack pnpm smoke:live` do not use this separate
# opt-in gate. Point this at a board reserved for disposable validation
# artifacts.
# TRELLO_LIVE_REGRESSION=1
# TRELLO_LIVE_REGRESSION_BOARD_ID=replace-with-disposable-board-id-or-short-link
# TRELLO_LIVE_REGRESSION_BOARD_URL=https://trello.com/b/shortlink/disposable-board
# TRELLO_LIVE_REGRESSION_RUN_ID=optional-human-readable-run-id
# TRELLO_LIVE_REGRESSION_DOMAINS=cards,attachments
# TRELLO_LIVE_REGRESSION_TOOLS=card_get,card_attachment_upload
# TRELLO_LIVE_REGRESSION_REPORT_JSON=reports/live-regression.json
# TRELLO_LIVE_REGRESSION_UPLOAD_FILE=relative-or-absolute-file-inside-upload-root

### Docker Compose
# Bind to 127.0.0.1 for local-only access. Use 0.0.0.0 to expose on all host interfaces.
TRELLO_MCP_HOST_BIND_IP=127.0.0.1
TRELLO_MCP_HOST_PORT=3000
TRELLO_MCP_IMAGE_TAG=latest
TRELLO_MCP_NETWORK=trello-mcp_network

# Note: future webhook tools require callback URLs that are publicly reachable by Trello.
