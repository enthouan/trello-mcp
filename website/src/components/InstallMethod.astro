---
// biome-ignore lint/correctness/noUnusedImports: referenced from the Astro template
import { Code } from "@astrojs/starlight/components";
import { getInstallMethod, type InstallMethodKey } from "../data/install.js";

interface Props {
  method: InstallMethodKey;
  showGuideLink?: boolean;
}

// biome-ignore lint/correctness/noUnusedVariables: referenced from the Astro template
const { method: methodKey, showGuideLink = false } = Astro.props;
const method = getInstallMethod(methodKey);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// biome-ignore lint/correctness/noUnusedVariables: referenced from the Astro template
const guideHref = `${base}${method.href.replace(/^\//, "")}`;
---

<div class="install-method" data-install-method={method.key}>
  <Code code={method.code} lang={method.language} title={method.title} />
  {
    method.key === "docker" && (
      <p>
        The published image is <code>ghcr.io/enthouan/trello-mcp</code>. Compose publishes only to{" "}
        <code>127.0.0.1</code> by default; configure <code>MCP_AUTH_TOKEN</code> whenever a client
        should also present a separate server bearer token.
      </p>
    )
  }
  {
    method.key === "http" && (
      <p>
        Connect to <code>http://127.0.0.1:3000/mcp</code>. The local Compose file builds the
        checkout and keeps the host publication on loopback by default.
      </p>
    )
  }
  {
    method.key === "stdio" && (
      <p>
        Build the checkout first. Stdio opens no network listener and does not use{" "}
        <code>MCP_AUTH_TOKEN</code>; keep the client configuration private because it contains the
        Trello credentials.
      </p>
    )
  }
  {showGuideLink && <a href={guideHref}>Read the complete {method.label} guide →</a>}
</div>
