---
// biome-ignore lint/correctness/noUnusedImports: referenced from the Astro template
import { Aside, Code } from "@astrojs/starlight/components";
// biome-ignore lint/correctness/noUnusedImports: referenced from the Astro template
import { VERIFY_EXPECTED, VERIFY_PROMPT } from "../data/clients.js";

interface Props {
  headingId?: string;
}

// biome-ignore lint/correctness/noUnusedVariables: referenced from the Astro template
const { headingId = "verify-setup" } = Astro.props;
---

<section aria-labelledby={headingId}>
  <h3 id={headingId}>Verify it works</h3>
  <p>After the client discovers the server, review and approve only this named read-only call:</p>
  <Code code={VERIFY_PROMPT} lang="text" meta='title="Read-only verification prompt"' />
  <Aside type="tip" title="Expected result">
    <p>{VERIFY_EXPECTED}</p>
  </Aside>
</section>
