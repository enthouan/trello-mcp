---
// biome-ignore lint/correctness/noUnusedImports: referenced from the Astro template
import { TabItem, Tabs } from "@astrojs/starlight/components";
// biome-ignore lint/correctness/noUnusedImports: referenced from the Astro template
import InstallMethod from "./InstallMethod.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// biome-ignore lint/correctness/noUnusedVariables: referenced from the Astro template
const guideRoot = `${base}getting-started/`;
---

<div class="install-methods" data-install-methods>
  <Tabs syncKey="install-method">
    <TabItem label="Local stdio">
      <InstallMethod method="stdio" showGuideLink />
    </TabItem>
    <TabItem label="HTTP · published image">
      <InstallMethod method="docker" showGuideLink />
    </TabItem>
    <TabItem label="HTTP · source build">
      <InstallMethod method="http" showGuideLink />
    </TabItem>
  </Tabs>
  <noscript>
    <style>
      [data-install-methods] starlight-tabs {
        display: none !important;
      }
    </style>
    <nav aria-label="Installation guides without JavaScript">
      JavaScript is disabled. Open the <a href={`${guideRoot}stdio/`}>local stdio</a>,{" "}
      <a href={`${guideRoot}docker/`}>published-image HTTP</a>, or{" "}
      <a href={`${guideRoot}http/`}>source-built HTTP</a> guide to read every setup method.
    </nav>
  </noscript>
</div>
