<script>
  import {
    REPOSITORY_API_URL,
    formatRepositoryStarCount,
    formatRepositoryStarCountLabel,
    isRepositoryStarCount,
  } from "../data/repository.js";

  const CACHE_KEY = "trello-mcp:repository-star-count";
  const ATTEMPT_CACHE_VALUE = "attempted";
  const SVG_NAMESPACE = "http://www.w3.org/2000/svg";
  const STAR_PATH =
    "M22 9.67a1 1 0 0 0-.86-.67l-5.69-.83L12.9 3a1 1 0 0 0-1.8 0L8.55 8.16 2.86 9a1 1 0 0 0-.81.68 1 1 0 0 0 .25 1l4.13 4-1 5.68a1 1 0 0 0 1.45 1.07L12 18.76l5.1 2.68c.14.08.3.12.46.12a1 1 0 0 0 .99-1.19l-1-5.68 4.13-4A1 1 0 0 0 22 9.67Zm-6.15 4a1 1 0 0 0-.29.89l.72 4.19-3.76-2a1 1 0 0 0-.94 0l-3.76 2 .72-4.19a1 1 0 0 0-.29-.89l-3-3 4.21-.61a1 1 0 0 0 .76-.55L12 5.7l1.88 3.82a1 1 0 0 0 .76.55l4.21.61-3 2.99Z";

  function availableSessionStorage(): Storage | undefined {
    try {
      const storage = globalThis.sessionStorage;
      const probeKey = `${CACHE_KEY}:available`;
      storage.setItem(probeKey, "1");
      storage.removeItem(probeKey);
      return storage;
    } catch {
      return undefined;
    }
  }

  type CachedStarCount =
    | { status: "count"; value: number }
    | { status: "attempted" }
    | { status: "miss" };

  function cachedStarCount(storage: Storage): CachedStarCount {
    try {
      const cached = storage.getItem(CACHE_KEY);
      if (cached === null) return { status: "miss" };
      if (cached === ATTEMPT_CACHE_VALUE) return { status: "attempted" };

      const value: unknown = JSON.parse(cached);
      if (isRepositoryStarCount(value)) {
        return { status: "count", value };
      }

      storage.removeItem(CACHE_KEY);
      return { status: "miss" };
    } catch {
      return { status: "miss" };
    }
  }

  function cacheAttempt(storage: Storage): boolean {
    try {
      storage.setItem(CACHE_KEY, ATTEMPT_CACHE_VALUE);
      return true;
    } catch {
      return false;
    }
  }

  function starIcon() {
    const icon = document.createElementNS(SVG_NAMESPACE, "svg");
    icon.setAttribute("aria-hidden", "true");
    icon.setAttribute("viewBox", "0 0 24 24");
    icon.setAttribute("fill", "currentColor");
    icon.setAttribute("width", "16");
    icon.setAttribute("height", "16");

    const path = document.createElementNS(SVG_NAMESPACE, "path");
    path.setAttribute("d", STAR_PATH);
    icon.append(path);
    return icon;
  }

  function showStarCount(action: HTMLAnchorElement, starCount: number) {
    const visibleCount = formatRepositoryStarCount(starCount);
    const accessibleCount = formatRepositoryStarCountLabel(starCount);
    if (!visibleCount || !accessibleCount) return;

    const group = document.createElement("span");
    group.className = "star-count";
    group.dataset.repositoryStarCount = "";
    group.setAttribute("aria-hidden", "true");
    group.append(starIcon(), visibleCount);

    const fallbackLabel =
      action.getAttribute("aria-label") ??
      action.textContent?.trim() ??
      "View on GitHub";
    action.append(group);
    action.setAttribute("aria-label", `${fallbackLabel}, ${accessibleCount}`);
  }

  async function enhanceRepositoryAction() {
    const action = document.querySelector<HTMLAnchorElement>(
      ".hero [data-github-action]",
    );
    if (!action || action.dataset.repositoryStarState) return;
    action.dataset.repositoryStarState = "loading";

    const storage = availableSessionStorage();
    if (!storage) {
      action.dataset.repositoryStarState = "complete";
      return;
    }

    const cached = cachedStarCount(storage);
    if (cached.status === "count") {
      showStarCount(action, cached.value);
      action.dataset.repositoryStarState = "complete";
      return;
    }
    if (cached.status === "attempted") {
      action.dataset.repositoryStarState = "complete";
      return;
    }

    if (!cacheAttempt(storage)) {
      action.dataset.repositoryStarState = "complete";
      return;
    }

    try {
      const response = await fetch(REPOSITORY_API_URL, {
        credentials: "omit",
        referrerPolicy: "no-referrer",
      });
      if (!response.ok) return;

      const payload: unknown = await response.json();
      if (typeof payload !== "object" || payload === null || Array.isArray(payload)) {
        return;
      }

      const starCount = (payload as { stargazers_count?: unknown })
        .stargazers_count;
      if (!isRepositoryStarCount(starCount)) return;

      try {
        storage.setItem(CACHE_KEY, JSON.stringify(starCount));
      } catch {
        return;
      }
      showStarCount(action, starCount);
    } catch {
      // The static repository link is the intentional fallback.
    } finally {
      action.dataset.repositoryStarState = "complete";
    }
  }

  document.addEventListener("astro:page-load", () => {
    void enhanceRepositoryAction();
  });
  void enhanceRepositoryAction();
</script>
