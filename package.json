{
  "name": "trello-mcp",
  "version": "0.9.0",
  "description": "Self-hostable Model Context Protocol server for Trello.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:workflow-pinning": "vitest run tests/workflow-actions.test.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "regression:live": "tsx scripts/live-regression.ts",
    "lint": "biome check .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/generate-tool-docs.ts --check",
    "website:dev": "pnpm --dir website dev",
    "website:typecheck": "pnpm --dir website typecheck",
    "website:build": "pnpm --dir website build",
    "website:og": "tsx website/scripts/render-og-image.ts",
    "website:og:check": "tsx website/scripts/render-og-image.ts --check",
    "website:preview": "pnpm --dir website preview",
    "website:contracts:run": "vitest run --config vitest.website.config.ts",
    "website:contracts": "pnpm docs:check && pnpm website:og:check && pnpm website:build && pnpm website:contracts:run",
    "website:test:run": "playwright test --config website/playwright.config.ts",
    "website:test": "pnpm website:build && pnpm website:test:run",
    "website:visual:run": "playwright test --config website/playwright.config.ts website/tests/visual.spec.ts",
    "website:visual": "pnpm website:build && pnpm website:visual:run",
    "website:lighthouse": "pnpm website:build && tsx website/scripts/lighthouse.ts",
    "website:check": "pnpm docs:check && pnpm website:og:check && pnpm website:typecheck && pnpm website:build && pnpm website:contracts:run && pnpm website:test:run",
    "verify": "tsc --noEmit && biome check . && tsc -p tsconfig.build.json && vitest run",
    "verify:coverage": "tsc --noEmit && biome check . && tsc -p tsconfig.build.json && vitest run --coverage",
    "docker:build": "docker build -t trello-mcp .",
    "docs:tools": "tsx scripts/generate-tool-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "parse5": "7.3.0",
    "smol-toml": "1.7.1",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.34.1"
}
