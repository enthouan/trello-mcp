{
  "name": "trello-mcp",
  "version": "0.8.1",
  "description": "Self-hostable Model Context Protocol server for Trello.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "regression:live": "tsx scripts/live-regression.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/generate-tool-docs.ts --check",
    "site:dev": "ASTRO_DEV_BACKGROUND=0 astro dev --root website",
    "site:check": "astro check --root website",
    "site:build": "astro build --root website",
    "site:og": "tsx website/scripts/render-og-image.ts",
    "site:og:check": "tsx website/scripts/render-og-image.ts --check",
    "site:preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview --root website",
    "site:test": "playwright test --config website/playwright.config.ts",
    "site:visual": "playwright test --config website/playwright.config.ts website/tests/visual.spec.ts",
    "site:lighthouse": "tsx website/scripts/lighthouse.ts",
    "verify": "tsc --noEmit && biome check . && tsc -p tsconfig.build.json && vitest run",
    "verify:coverage": "tsc --noEmit && biome check . && tsc -p tsconfig.build.json && vitest run --coverage",
    "docker:build": "docker build -t trello-mcp .",
    "docs:tools": "tsx scripts/generate-tool-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "0.41.7",
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.2.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.34.1"
}
