{
  "name": "trello-mcp",
  "version": "0.3.0",
  "description": "Self-hostable Model Context Protocol server for Trello.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t trello-mcp .",
    "docs:tools": "tsx scripts/generate-tool-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@10.34.1"
}
