{
  "name": "trello-mcp",
  "version": "0.1.0",
  "description": "Self-hostable Model Context Protocol server for Trello.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t trello-mcp .",
    "docs:tools": "tsx scripts/generate-tool-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "pino": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.12.1"
}
